<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression suite. Runs test methods in parallel, 3 browsers at a time. -->
<suite name="Regression" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.example.listeners.ScreenshotListener"/>
    </listeners>
    <test name="All tests">
        <packages>
            <package name="com.example.tests"/>
        </packages>
    </test>
</suite>
