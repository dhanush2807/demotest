<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Quick smoke suite: only tests in the "smoke" group. Run with: mvn test -Dsuite=smoke.xml -->
<suite name="Smoke" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.example.listeners.ScreenshotListener"/>
    </listeners>
    <test name="Smoke tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.example.tests"/>
        </packages>
    </test>
</suite>
